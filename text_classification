      "source": [
        "# Building the Interface Based on SVM"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "In this step, we deploy the trained SVM model using Gradio to create an interactive interface. The pipeline loads the TF-IDF + LinearSVC model, maps predictions to class labels, and allows users to input text for real-time cyberbullying classification."
      ],
      "metadata": {
        "id": "-6q1wH1u0z0_"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# === Minimal, SVM-based Gradio UI (uses your saved pipeline) ===\n",
        "import joblib, gradio as gr, pandas as pd, numpy as np\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# 1) Load YOUR combined pipeline (TF-IDF + LinearSVC)\n",
        "pipe = joblib.load(\"svm_tfidf_pipeline.joblib\")      # <-- changed\n",
        "clf  = getattr(pipe, \"named_steps\", {}).get(\"clf\", None) or pipe  # get last step if named, else pipe\n",
        "\n",
        "# 2) Fixed display order (your preferred names)\n",
        "CLASS_LABELS = [\"age\",\"ethnicity\",\"gender\",\"not_cyberbullying\",\"other_cyberbullying\",\"religion\"]\n",
        "\n",
        "# 3) Map internal class ids -> your names\n",
        "model_classes = getattr(clf, \"classes_\", getattr(pipe, \"classes_\", np.arange(len(CLASS_LABELS))))\n",
        "def _name_for(c):\n",
        "    try: return CLASS_LABELS[int(c)]\n",
        "    except: return str(c)\n",
        "id2name = {c: _name_for(c) for c in model_classes}\n",
        "\n",
        "def predict_one(text: str):\n",
        "    text = (text or \"\").strip()\n",
        "    if not text:\n",
        "        return \"—\", pd.DataFrame(columns=[\"Class\",\"Score\"]), \"Type something above and click Predict.\"\n",
        "\n",
        "    pred = pipe.predict([text])[0]\n",
        "    try:\n",
        "        pred_label = id2name.get(pred, id2name.get(int(pred), str(pred)))\n",
        "    except:\n",
        "        pred_label = str(pred)\n",
        "\n",
        "    # 4) Confidence table\n",
        "    if hasattr(clf, \"predict_proba\"):  # calibrated SVM or LR would use this\n",
        "        probs = clf.predict_proba([text])[0] if clf is pipe else pipe.predict_proba([text])[0]\n",
        "        pairs = [(id2name[c], float(p)) for c, p in zip(model_classes, probs)]\n",
        "        note = \"Confidence scores are probabilities.\"\n",
        "    else:\n",
        "        # LinearSVC path: use decision_function via the pipeline\n",
        "        scores = pipe.decision_function([text])[0]        # <-- no need to call vectorizer explicitly\n",
        "        # Softmax scaling to relative scores (display only; not true probabilities)\n",
        "        exp_scores = np.exp(scores - np.max(scores))\n",
        "        probs = exp_scores / (exp_scores.sum() + 1e-12)\n",
        "        pairs = [(id2name[c], float(p)) for c, p in zip(model_classes, probs)]\n",
        "        note = \"Scaled decision scores (LinearSVC).\"\n",
        "\n",
        "    pairs.sort(key=lambda x: x[1], reverse=True)\n",
        "    table = pd.DataFrame(pairs, columns=[\"Class\",\"Score\"])\n",
        "    table[\"Score\"] = table[\"Score\"].map(lambda x: f\"{x:.3f}\")\n",
        "    return pred_label, table, note\n",
        "\n",
        "custom_css = \"\"\"\n",
        "#app .gradio-container {max-width: 920px}\n",
        ".badge{display:inline-block;padding:6px 12px;border-radius:999px;background:#eef2ff;color:#1f2937;\n",
        "       font-weight:600;margin:2px 6px 0 0;border:1px solid #c7d2fe;}\n",
        ".pred{font-size:1.25rem;font-weight:700;padding:10px 14px;border-radius:10px;background:#ecfdf5;\n",
        "      color:#065f46;border:1px solid #a7f3d0;display:inline-block;}\n",
        "\"\"\"\n",
        "\n",
        "with gr.Blocks(title=\"Cyberbullying Text Classifier\", css=custom_css, theme=gr.themes.Soft()) as demo:\n",
        "    gr.Markdown(\"\"\"\n",
        "# 🛡️ Cyberbullying Text Classifier\n",
        "\n",
        "**Classes:**\n",
        "<span class=\"badge\">age</span>\n",
        "<span class=\"badge\">ethnicity</span>\n",
        "<span class=\"badge\">gender</span>\n",
        "<span class=\"badge\">not_cyberbullying</span>\n",
        "<span class=\"badge\">other_cyberbullying</span>\n",
        "<span class=\"badge\">religion</span>\n",
        "\"\"\", elem_id=\"app\")\n",
        "\n",
        "    with gr.Row():\n",
        "        with gr.Column(scale=3):\n",
        "            inp = gr.Textbox(label=\"Input Text\", placeholder=\"Type a tweet/text here...\", lines=4)\n",
        "            with gr.Row():\n",
        "                btn = gr.Button(\"🔮 Predict\", variant=\"primary\")\n",
        "                clr = gr.Button(\"🧹 Clear\")\n",
        "        with gr.Column(scale=2):\n",
        "            pred = gr.HTML(label=\"Predicted Class\")\n",
        "            probs = gr.DataFrame(headers=[\"Class\",\"Score\"], datatype=[\"str\",\"str\"],\n",
        "                                 interactive=False, wrap=True, label=\"Confidence (Top Scores)\",\n",
        "                                 row_count=(6,\"fixed\"))\n",
        "            note = gr.Markdown(\"\")\n",
        "    def _go(text):\n",
        "        label, table, details = predict_one(text)\n",
        "        label_html = f'<div class=\"pred\">Predicted: {label}</div>' if label != \"—\" else \"—\"\n",
        "        return label_html, table, details\n",
        "    btn.click(_go, inputs=inp, outputs=[pred, probs, note])\n",
        "    inp.submit(_go, inputs=inp, outputs=[pred, probs, note])\n",
        "    clr.click(lambda: (\"\", pd.DataFrame(columns=[\"Class\",\"Score\"]), \"\"), outputs=[pred, probs, note])\n",
        "\n",
        "demo.launch()\n"
      ],
