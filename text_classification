        "# bar plot\n",
        "def plot_ngrams(pairs, title):\n",
        "    tokens, freqs = zip(*pairs)\n",
        "    import matplotlib.pyplot as plt\n",
        "    plt.figure(figsize=(8,4))\n",
        "    plt.barh(range(len(tokens)), freqs)\n",
