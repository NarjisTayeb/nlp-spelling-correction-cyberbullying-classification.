        "def normalize_elongation(text):\n",
        "    \"\"\"Reduce elongated words: 'soooo' becomes 'soo', 'loooove' becomes 'loove'\"\"\"\n",
        "    return re.sub(r'(.)\\1{2,}', r'\\1\\1', text)\n",
