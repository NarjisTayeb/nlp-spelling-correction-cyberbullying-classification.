      "source": [
        "import matplotlib.pyplot as plt\n",
        "import re # Import the regular expression module\n",
        "\n",
        "# Function to detect emojis\n",
        "def has_emoji(text):\n",
        "    # A simple regex for common emojis. This might not catch all emojis.\n",
        "    emoji_pattern = re.compile(r'[\\U0001F600-\\U0001F64F\\U0001F300-\\U0001F5FF\\U0001F680-\\U0001F6FF\\U0001F900-\\U0001F9FF\\U00002600-\\U000026FF\\U00002700-\\U000027BF]')\n",
        "    return bool(emoji_pattern.search(str(text)))\n",
        "\n",
        "# Create the 'has_emoji' column\n",
        "df[\"has_emoji\"] = df[\"tweet_text\"].apply(has_emoji)\n",
        "\n",
        "# Count tweets with and without emojis\n",
        "emoji_stats = df[\"has_emoji\"].value_counts().rename({True: \"Has Emoji\", False: \"No Emoji\"})\n",
        "\n",
        "print(\"Total tweets:\", len(df))\n",
        "print(\"Tweets with emojis:\", emoji_stats.get(\"Has Emoji\", 0))\n",
        "print(\"Tweets without emojis:\", emoji_stats.get(\"No Emoji\", 0))\n",
        "print(\"Percentage with emojis:\", round(emoji_stats.get(\"Has Emoji\", 0) / len(df) * 100, 2), \"%\")\n",
        "\n",
        "# Bar chart\n",
        "plt.figure(figsize=(5,4))\n",
        "emoji_stats.plot(kind=\"bar\", color=[\"orange\",\"skyblue\"])\n",
        "plt.title(\"Emoji Presence in Cyberbullying Tweets\")\n",
        "plt.ylabel(\"Number of Tweets\")\n",
        "plt.xticks(rotation=0)\n",
        "plt.show()"
      ]
    },
