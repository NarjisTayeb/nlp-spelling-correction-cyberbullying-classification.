        "# Feature importance for Logistic Regression\n",
        "def analyze_feature_importance(model, vectorizer, class_names, top_n=10):\n",
        "    \"\"\"Analyze most important features for each class\"\"\"\n",
        "\n",
        "    if hasattr(model, 'coef_'):\n",
        "        feature_names = vectorizer.get_feature_names_out()\n",
        "\n",
        "        print(\"=== FEATURE IMPORTANCE ANALYSIS ===\")\n",
        "        for i, class_name in enumerate(class_names):\n",
        "            print(f\"\\nTop features for {class_name}:\")\n",
        "\n",
        "            # Get coefficients for this class\n",
        "            if len(model.coef_) > 1:  # multiclass\n",
        "                coef = model.coef_[i]\n",
        "            else:  # binary\n",
        "                coef = model.coef_[0] if i == 1 else -model.coef_[0]\n",
        "\n",
        "            # Get top positive features\n",
        "            top_positive_idx = np.argsort(coef)[-top_n:][::-1]\n",
        "            for idx in top_positive_idx[:5]:\n",
        "                print(f\"  + {feature_names[idx]}: {coef[idx]:.3f}\")\n",
        "\n",
        "            # Get top negative features\n",
        "            top_negative_idx = np.argsort(coef)[:5]\n",
        "            for idx in top_negative_idx:\n",
        "                print(f\"  - {feature_names[idx]}: {coef[idx]:.3f}\")\n",
        "\n",
        "# Call it\n",
        "try:\n",
