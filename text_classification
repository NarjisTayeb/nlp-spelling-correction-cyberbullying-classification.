        "def expand_contractions_safe(text):\n",
        "    \"\"\"Expand contractions like don't → do not, it's → it is\"\"\"\n",
        "    try:\n",
        "        return contractions.fix(text)\n",
        "    except:\n",
        "        return text  # Return original if expansion fails\n",
