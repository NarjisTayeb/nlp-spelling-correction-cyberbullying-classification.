      "source": [
        "# ==============================\n",
        "# CELL 3: Tweet-Specific Preprocessing Function\n",
        "# ==============================\n",
        "def tweet_preprocess(text):\n",
        "    \"\"\"\n",
        "    Tweet-specific preprocessing:\n",
        "    - Uses NLTK's TweetTokenizer for social media handling\n",
        "    - Applies spaCy for lemmatization\n",
        "    - Removes hashtags, mentions, punctuation, short tokens\n",
        "    \"\"\"\n",
        "    if not text:\n",
        "        return \"\"\n",
        "\n",
        "    tweet_tokenizer = TweetTokenizer(\n",
        "        preserve_case=False,    # Convert to lowercase\n",
        "        reduce_len=True,        # Reduce repeated chars (loooove → love)\n",
        "        strip_handles=True      # Remove @mentions\n",
        "    )\n",
        "\n",
        "    tokens = tweet_tokenizer.tokenize(text)\n",
        "    processed_text = ' '.join(tokens)\n",
        "    doc = nlp(processed_text)\n",
        "\n",
        "    final_tokens = [\n",
        "        token.lemma_.lower()\n",
        "        for token in doc\n",
        "        if not (token.is_stop and token.text.lower() not in keep_stopwords)\n",
        "        and not token.is_punct\n",
        "        and not token.is_space\n",
        "        and len(token.text) > 2\n",
        "        and token.lemma_.lower() not in stop_words\n",
        "        and not token.text.startswith('#')  # Remove hashtags\n",
        "    ]\n",
        "\n",
        "    return ' '.join(final_tokens)\n"
      ]
    },
